rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isStaff() {
      return userRole() in ['admin', 'committee'];
    }

    function adminCanUpdateParticipant() {
      return isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'paymentStatus', 'registrationStatus', 'serialNumber', 'paymentGroupId',
          'checkedInAt', 'checkedInBy'
        ]);
    }

    match /participants/{participantId} {
      allow create: if false;
      allow get, list: if isStaff();
      allow update: if adminCanUpdateParticipant() || (userRole() == 'committee'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'scores', 'score', 'scoredAt', 'scoreUpdatedAt', 'position', 'prize',
          'verificationStatus', 'verifiedAt'
        ]));
      allow delete: if isAdmin();
    }

    match /scores/{participantId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.participantId == participantId
        && request.resource.data.keys().hasOnly([
          'participantId', 'studentName', 'serialNumber', 'instructor', 'institution',
          'event', 'category', 'level', 'gender', 'class', 'asana1', 'asana2',
          'asana3', 'asana4', 'asana5', 'scores', 'total', 'position', 'prize',
          'updatedAt', 'savedAt', 'evaluatedBy'
        ]);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /events/{documentId} {
      allow read, write: if isAdmin();
    }

    match /categories/{documentId} {
      allow read, write: if isAdmin();
    }

    match /ageGroups/{documentId} {
      allow read, write: if isAdmin();
    }

    match /scoringTemplates/{documentId} {
      allow read, write: if isAdmin();
    }
  }
}